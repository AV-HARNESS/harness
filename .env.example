# harness configuration. Copy to .env and uncomment ONE auth block (A, B or C).
# Everything below is commented out on purpose: placeholders must never be live.
# Never commit .env or certificate files.

# --- A. Gemini API key (simplest, no GCP project) ---------------------------------
# GEMINI_API_KEY=                 # https://aistudio.google.com/app/apikey

# --- B. Vertex AI with Google OAuth (run `python -m harness login` once) ----------
# VERTEX_PROJECT=
# VERTEX_LOCATION=global          # or us-central1, europe-west4, ...
# GOOGLE_CLIENT_ID=               # OAuth "Desktop app" client; ID ends .apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ACCESS_TOKEN=            # optional one-off: $(gcloud auth print-access-token), lasts ~1h

# --- C. Org gateway with client credentials (no browser login) --------------------
# OAUTH_TOKEN_URL=                # token endpoint, e.g. https://<sso-host>/as/token.oauth2
# OAUTH_SCOPE=                    # scope issued with your client
# OAUTH_AUDIENCE=                 # only if your IdP requires it
# OAUTH_CLIENT_AUTH=body          # body (default) or basic
# GOOGLE_CLIENT_ID=               # the client ID / secret issued by your platform team
# GOOGLE_CLIENT_SECRET=
# VERTEX_HOST=                    # gateway base URL
# VERTEX_PROJECT=                 # as the gateway expects
# VERTEX_LOCATION=

# --- Corporate TLS (needed if you see CERTIFICATE_VERIFY_FAILED) ------------------
# Point to your company CA bundle (.pem). Reference it in place; don't copy it into this repo.
# REQUESTS_CA_BUNDLE=C:\path\to\combined_ca_certs.pem

# --- Other providers: add aliases in ~/.harness/models.json (see models.example.json)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Privacy: secrets/PII are masked before any model call (on by default) -------
# HARNESS_REDACT=1                # set 0 to disable
# HARNESS_REDACT_TERMS=           # comma list of words to mask too (client or project names, internal hosts)
# HARNESS_BLOCK_FILES=            # extra file name patterns the model may not read/write, e.g. *.cer,secrets.yml

# HARNESS_REDACT_STRICT=0         # 1 = also mask 9+ digit numbers and user names in paths (C:\\Users\\name, /home/name)
# HARNESS_REDACT_PATTERNS=        # your own regexes, separated by ||  e.g. ACME-\\d{6}||cust_[a-z]+
# HARNESS_AUDIT_LOG=              # 1 = write every request as sent (masked) to ~/.harness/audit.jsonl, or give a path
# HARNESS_DRY_RUN=0               # 1 = build + mask + show the request, but do not call the model

# --- Optional behaviour (defaults shown) ------------------------------------------
# HARNESS_DEFAULT_MODEL=flash     # model alias used by default
# GEMINI_FLASH_MODEL=gemini-2.5-flash
# GEMINI_PRO_MODEL=gemini-2.5-pro
# HARNESS_MAX_STEPS=200           # safety cap on tool-call steps per turn (0 is not unlimited; raise it if needed)
# HARNESS_COMPACT_AT=600000       # summarize history above this many prompt tokens
# HARNESS_HOME=~/.harness         # where projects, blocks and sessions are stored
