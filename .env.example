# ============================================================
#  harness — environment configuration
#  Copy to .env and fill in what you need.
#  Never commit .env to git.
# ============================================================
#
#  QUICK START (pick ONE block below):
#    Option A — Gemini API key   → uncomment block A, done.
#    Option B — Vertex AI        → uncomment block B + C, run `python3 -m harness login`.
#    Option C — Anthropic only   → uncomment block D, add model to ~/.harness/models.json.
#
# ============================================================


# ── A. Gemini API key ─────────────────────────────────────────────────────────
#  Get one at: https://aistudio.google.com/app/apikey
#  This is the simplest option — no GCP project needed.
#
GEMINI_API_KEY=AIzaSy_REPLACE_WITH_YOUR_KEY


# ── B. Vertex AI (GCP project) ───────────────────────────────────────────────
#  Use instead of GEMINI_API_KEY if you have a GCP project.
#  After setting these, run:  python3 -m harness login
#
# VERTEX_PROJECT=my-gcp-project-id        # e.g. my-company-dev-123456
# VERTEX_LOCATION=us-central1             # or: global, europe-west4, asia-northeast1
# VERTEX_HOST=                            # leave blank unless your org uses a gateway URL


# ── C. Google OAuth client (required for Vertex browser login) ────────────────
#  Create a "Desktop app" OAuth client at:
#  https://console.cloud.google.com/apis/credentials
#  Then run `python3 -m harness login` once to get a refresh token.
#
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE_ME
# GOOGLE_REFRESH_TOKEN=1//REPLACE_after_login   # written by `harness login`, paste here to skip browser
# GOOGLE_ACCESS_TOKEN=                          # optional: paste $(gcloud auth print-access-token) for one-off use


# ── D. Anthropic ──────────────────────────────────────────────────────────────
#  Get key at: https://console.anthropic.com/settings/keys
#  Then add an entry to ~/.harness/models.json referencing ANTHROPIC_API_KEY, e.g.:
#    "claude": {"provider": "anthropic", "model": "claude-opus-4-8", "api_key_env": "ANTHROPIC_API_KEY"}
#
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME


# ── E. OpenAI / OpenRouter / Ollama / any OpenAI-compatible endpoint ──────────
#  Add a model entry in ~/.harness/models.json referencing the key env var, e.g.:
#    "gpt4o": {"provider": "openai", "model": "gpt-4o", "api_key_env": "OPENAI_API_KEY"}
#    "openrouter": {"provider": "openai", "model": "meta-llama/llama-3.3-70b-instruct",
#                   "base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY"}
#    "ollama": {"provider": "openai", "model": "llama3.2", "base_url": "http://localhost:11434/v1"}
#
# OPENAI_API_KEY=sk-REPLACE_ME
# OPENROUTER_API_KEY=sk-or-REPLACE_ME


# ── F. Org SSO gateway (client-credentials, no browser login) ─────────────────
#  If your company fronts Vertex or another model behind an OAuth token endpoint:
#
# OAUTH_TOKEN_URL=https://sso.your-company.com/oauth2/token
# OAUTH_SCOPE=https://www.googleapis.com/auth/cloud-platform
# OAUTH_AUDIENCE=                         # leave blank if not required by your IdP
# OAUTH_CLIENT_AUTH=body                  # body (default) or basic
# GOOGLE_CLIENT_ID=your-service-account-client-id
# GOOGLE_CLIENT_SECRET=your-service-account-secret


# ── G. Agent behaviour (optional, defaults shown) ─────────────────────────────
#
# HARNESS_DEFAULT_MODEL=flash             # which model alias to use by default
# HARNESS_MAX_STEPS=40                    # max tool-call iterations per turn
# HARNESS_COMPACT_AT=600000              # compact history after this many prompt tokens
# HARNESS_HOME=~/.harness                # where projects/sessions/blocks are stored
# GEMINI_FLASH_MODEL=gemini-2.5-flash    # override the built-in flash model ID
# GEMINI_PRO_MODEL=gemini-2.5-pro        # override the built-in pro model ID
